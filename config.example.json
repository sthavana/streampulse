{
  "metrics_addr": ":9090",
  "slack_webhook": "",
  "alerting": {
    "for_seconds": 0,
    "resolve_after_seconds": 90,
    "repeat_every_seconds": 0,
    "sweep_seconds": 10
  },
  "maintenance": [
    {
      "name": "nightly encoder restart",
      "targets": ["example-live-channel"],
      "timezone": "America/Los_Angeles",
      "daily": { "start": "02:00", "end": "04:00", "days": ["Sat", "Sun"] }
    },
    {
      "name": "packager upgrade",
      "start": "2026-09-15T22:00:00Z",
      "end": "2026-09-16T02:00:00Z"
    }
  ],
  "targets": [
    {
      "name": "apple-bipbop-fmp4",
      "url": "https://devstreaming-cdn.apple.com/videos/streaming/examples/img_bipbop_adv_example_fmp4/master.m3u8",
      "interval_seconds": 15,
      "max_variants": 3,
      "segment_sample": 2,
      "expect_live": false,
      "min_window_seconds": 0
    },
    {
      "name": "example-live-channel",
      "url": "https://example.com/live/channel1/master.m3u8",
      "interval_seconds": 6,
      "max_variants": 0,
      "max_renditions": 0,
      "rendition_types": ["AUDIO"],
      "segment_sample": 2,
      "expect_live": true,
      "min_window_seconds": 30,
      "expect_encrypted": true,
      "fetch_keys": true,
      "key_rotation_max_seconds": 3600
    }
  ]
}
