# The multiviewer. Debian rather than scratch because it decodes video: ffmpeg
# is not optional here the way it is for the prober, which keeps its own image
# at 10MB precisely because this one exists separately.
FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mosaic ./cmd/mosaic

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Unprivileged: the wall reads streams and writes nothing.
RUN useradd --system --uid 10001 mosaic
USER 10001
COPY --from=build /out/mosaic /usr/local/bin/mosaic
EXPOSE 9091
ENTRYPOINT ["/usr/local/bin/mosaic"]
